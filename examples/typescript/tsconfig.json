{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2019",
    "declaration": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*"]
}
