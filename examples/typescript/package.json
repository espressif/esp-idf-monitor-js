{
  "name": "esp-idf-monitor-example",
  "version": "0.1.0",
  "description": "Browser example for esp-idf-monitor-js, published with GitHub Pages",
  "source": "src/index.html",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm-run-all clean parcel:build",
    "clean": "shx rm -rf dist .parcel-cache",
    "dev": "npm-run-all clean parcel:dev",
    "parcel:dev": "cross-env PARCEL_WORKERS=0 parcel src/index.html",
    "parcel:build": "cross-env PARCEL_WORKERS=0 parcel build src/index.html --no-optimize --public-url ./"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.8.3",
    "shx": "^0.3.4",
    "typescript": "^5.3.3"
  }
}
